# Used only by the /api/health readiness probe. VaultZK stores NO user data in Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Local Ollama daemon (must be on the same machine for the offline guarantee)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b

# Branding / links shown in the UI
NEXT_PUBLIC_REPO_URL=https://github.com/vaultzk/vaultzk-engine
NEXT_PUBLIC_TEAM_NAME=the VaultZK team
